# Copy to .env. Never commit .env.

# Discovery only. Replay needs no model key.
OPENROUTER_API_KEY=
# Must support image input and tool calling.
DISCOVERY_MODEL=

# Synthetic credentials for the local CoreServ demo app.
CORESERV_OPERATOR_ID=teller01
CORESERV_OPERATOR_PASSWORD=
# Known only to the demo app and the human operator. Automation must never read this.
CORESERV_SUPERVISOR_CODE=
